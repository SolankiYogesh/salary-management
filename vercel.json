{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "hr-salary-management": {
      "root": "backend",
      "framework": "express"
    },
    "web": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "hr-salary-management"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
